<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080706"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ai.jas.remote.JasFace
            android:id="@+id/face"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F7F1E6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.5"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connecting"
            android:textColor="#A69C8D"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/said"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D8CEBE"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/host_hint"
            android:textColorHint="#7A7164"
            android:textColor="#F7F1E6"
            android:textSize="16sp"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pin_hint"
            android:textColorHint="#7A7164"
            android:textColor="#F7F1E6"
            android:textSize="16sp"
            android:inputType="number"
            android:importantForAutofill="no"
            android:layout_marginTop="6dp"/>

        <!-- The one button that matters, made unmistakably the one button that matters. -->
        <Button
            android:id="@+id/show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_jas"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#080706"
            android:backgroundTint="#E8BE76"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="18dp"/>

        <TextView
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/steps"
            android:textColor="#8A8174"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <EditText
                android:id="@+id/text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/type_hint"
                android:textColorHint="#7A7164"
                android:textColor="#F7F1E6"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textColor="#080706"
                android:backgroundTint="#E8BE76"
                android:text="@string/send"/>
        </LinearLayout>

        <!-- Everything below the line is rarely wanted, and is deliberately small and far from
             Show, because tapping Pair again by mistake is what stopped this working the first time. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2419"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/away_label"
            android:textColor="#8A8174"
            android:textSize="12sp"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/away"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/away_hint"
            android:textColorHint="#6B6358"
            android:textColor="#D8CEBE"
            android:textSize="13sp"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/cert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6B6358"
            android:textSize="10sp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/hide"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/hide_jas"
                android:textColor="#8A8174"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>

            <TextView
                android:id="@+id/repair"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/pair_again"
                android:textColor="#8A8174"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
