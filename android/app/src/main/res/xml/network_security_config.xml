<?xml version="1.0" encoding="utf-8"?>
<!-- The laptop serves HTTPS with its own certificate. Trusting certificates the user installed
     lets this app reach it without weakening anything else: no cleartext, no trust-all. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
