# Copy to .env and fill in. Never commit .env.

# --- General ---
LOG_LEVEL=INFO
# LOG_DIR=logs
# DATA_DIR=data

# --- Wake word ---
WAKE_WORD_ENABLED=true
# openwakeword = say "Hey Jarvis" (no account) | porcupine = say just "Jarvis"
WAKE_WORD_ENGINE=openwakeword
# Free AccessKey from https://console.picovoice.ai (needed only for porcupine)
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD=jarvis
# 0..1 — higher = catches more "Jarvis" but more false triggers
PORCUPINE_SENSITIVITY=0.5
# 0..1 — lower = more sensitive (more false triggers), higher = stricter
WAKE_WORD_THRESHOLD=0.5
# Empty = Windows default microphone. Or a device name / index.
MICROPHONE_DEVICE=

# --- Voice ---
# Piper voice name (downloaded automatically) and speed (1.0 = normal)
TTS_VOICE=en_GB-alan-medium
TTS_SPEED=1.0
# Whisper size: tiny / base / small / medium. Bigger = more accurate, slower, more RAM.
STT_MODEL=small
# Language of speech; empty = auto-detect
STT_LANGUAGE=en
# Names/words to expect (friends, apps, places), comma-separated. Helps with unusual names.
STT_VOCABULARY=Jarvis, Notepad, WhatsApp, VS Code, Chrome, YouTube

# Seconds of silence that end your sentence (raise if JARVIS cuts you off), wait-to-start, max length
LISTEN_END_SILENCE=1.5
LISTEN_START_TIMEOUT=8
LISTEN_MAX_SECONDS=30

# After an answer, keep listening this many seconds for a follow-up (0 = off)
FOLLOW_UP_SECONDS=6

# Your Chrome profile for websites & music (e.g. Likith); empty = the one you used last
CHROME_PROFILE=

# Wake JARVIS from anywhere without saying the wake word
HOTKEY=ctrl+space

# --- You ---
USER_NAME=Likki
HOME_CITY=Bengaluru
# Start in rest mode (and rest after the laptop wakes); "wake up, Jarvis" gives the morning briefing
START_RESTING=true
# Played in your Chrome after the briefing (a different video each day)
MORNING_MUSIC=calm good morning instrumental music
# Suggest a break after this many minutes of continuous screen use (0 = off)
BREAK_REMINDER_MINUTES=90

# --- AI brain ---
# Which brain to use: gemini (free) or claude (paid API)
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey -> paste after the = sign
GEMINI_API_KEY=
# Priority list: if a model is busy/unavailable the next one is used
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
# minimal (fastest) / low / medium / high
GEMINI_THINKING=minimal

# Claude: key from https://console.anthropic.com -> API Keys (needs prepaid credits)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Added in later phases (not read yet) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TTS_API_KEY=
