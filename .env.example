# Copy to .env and fill in. Never commit .env.

# --- General ---
LOG_LEVEL=INFO
# LOG_DIR=logs
# DATA_DIR=data

# --- Wake word ---
WAKE_WORD_ENABLED=true
# 0..1 — lower = more sensitive (more false triggers), higher = stricter
WAKE_WORD_THRESHOLD=0.5
# Empty = Windows default microphone. Or a device name / index.
MICROPHONE_DEVICE=

# --- Voice ---
# Piper voice name (downloaded automatically) and speed (1.0 = normal)
TTS_VOICE=en_GB-alan-medium
TTS_SPEED=1.0
# Whisper size: tiny / base / small / medium. Bigger = more accurate, slower, more RAM.
STT_MODEL=small
# Language of speech; empty = auto-detect
STT_LANGUAGE=en

# --- AI brain ---
# Which brain to use: gemini (free) or claude (paid API)
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey -> paste after the = sign
GEMINI_API_KEY=
# Priority list: if a model is busy/unavailable the next one is used
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview

# Claude: key from https://console.anthropic.com -> API Keys (needs prepaid credits)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Added in later phases (not read yet) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TTS_API_KEY=
